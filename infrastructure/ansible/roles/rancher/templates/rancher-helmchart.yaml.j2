{% set rancher_fleet = rancher.fleet | default({}) %}
{% set rancher_fleet_image = rancher_fleet.image | default({}) %}
{% set rancher_fleet_agent_image = rancher_fleet.agent_image | default({}) %}
{% set rancher_fleet_agent = rancher_fleet.agent | default({}) %}
{% set rancher_fleet_imagescan = rancher_fleet.imagescan | default({}) %}
{% set rancher_fleet_resources = rancher_fleet.resources | default({}) %}
{% set rancher_startup_probe = rancher.startup_probe | default({}) %}
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: rancher
  namespace: kube-system
spec:
  targetNamespace: {{ rancher.namespace }}
  createNamespace: true
  chart: rancher
  repo: https://releases.rancher.com/server-charts/stable
  version: {{ rancher.chart_version }}
  timeout: 15m
  valuesContent: |-
    hostname: {{ rancher.hostname }}
    replicas: {{ rancher.replicas }}
    antiAffinity: {{ rancher.anti_affinity }}
    topologyKey: {{ rancher.topology_key }}
    priorityClassName: {{ rancher.priority_class_name }}
    # The Rancher chart exposes extra tolerations but no conjunctive
    # control-plane selector. The role reconciles that selector on the rendered
    # Deployment after each chart update.
    extraTolerations:
      - key: CriticalAddonsOnly
        operator: Equal
        value: "true"
        effect: NoExecute
    resources:
      requests:
        cpu: {{ rancher.resources.requests.cpu }}
        memory: {{ rancher.resources.requests.memory }}
      limits:
        cpu: {{ rancher.resources.limits.cpu }}
        memory: {{ rancher.resources.limits.memory }}
    startupProbe:
      timeoutSeconds: {{ rancher_startup_probe.timeout_seconds | default(5) }}
      periodSeconds: {{ rancher_startup_probe.period_seconds | default(10) }}
      failureThreshold: {{ rancher_startup_probe.failure_threshold | default(36) }}
    bootstrapPassword: {{ rancher.bootstrap_password | quote }}
    tls: ingress
    ingress:
      includeDefaultExtraAnnotations: false
      ingressClassName: {{ rancher.ingress.class_name }}
      tls:
        source: {{ rancher.ingress.tls_source }}
{% if rancher.ingress.tls_source == 'secret' %}
        secretName: {{ rancher.ingress.tls_secret_name }}
{% endif %}
    service:
      type: {{ rancher.service.type }}
    fleet: |-
      nodeSelector:
        kubernetes.io/arch: arm64
        node-role.kubernetes.io/control-plane: "true"
      tolerations:
        - key: CriticalAddonsOnly
          operator: Equal
          value: "true"
          effect: NoExecute
      agent:
        replicas: {{ rancher_fleet_agent.replicas }}
{# Null values remove sticky Rancher Fleet overrides so chart defaults apply. #}
{% if rancher_fleet_image.repository | default('') | trim != '' %}
      image:
        repository: {{ rancher_fleet_image.repository }}
{% if rancher_fleet_image.tag | default('') | trim != '' %}
        tag: {{ rancher_fleet_image.tag }}
{% endif %}
{% else %}
      image: null
{% endif %}
{% if rancher_fleet_agent_image.repository | default('') | trim != '' %}
      agentImage:
        repository: {{ rancher_fleet_agent_image.repository }}
{% if rancher_fleet_agent_image.tag | default('') | trim != '' %}
        tag: {{ rancher_fleet_agent_image.tag }}
{% endif %}
{% else %}
      agentImage: null
{% endif %}
{% if rancher_fleet_agent_image.repository | default('') | trim != '' and rancher_fleet_agent_image.tag | default('') | trim != '' %}
      extraAnnotations:
        fleetController:
          home-lab.io/fleet-agent-image: {{ (rancher_fleet_agent_image.repository ~ ':' ~ rancher_fleet_agent_image.tag) | quote }}
{% else %}
      extraAnnotations: null
{% endif %}
      imagescan:
        enabled: {{ rancher_fleet_imagescan.enabled | default(false) | bool | lower }}
      resources:
        fleetController:
          requests:
            cpu: {{ rancher_fleet_resources.fleet_controller.requests.cpu }}
            memory: {{ rancher_fleet_resources.fleet_controller.requests.memory }}
          limits:
            cpu: {{ rancher_fleet_resources.fleet_controller.limits.cpu }}
            memory: {{ rancher_fleet_resources.fleet_controller.limits.memory }}
        fleetCleanup:
          requests:
            cpu: {{ rancher_fleet_resources.fleet_cleanup.requests.cpu }}
            memory: {{ rancher_fleet_resources.fleet_cleanup.requests.memory }}
          limits:
            cpu: {{ rancher_fleet_resources.fleet_cleanup.limits.cpu }}
            memory: {{ rancher_fleet_resources.fleet_cleanup.limits.memory }}
        fleetAgentmanagement:
          requests:
            cpu: {{ rancher_fleet_resources.fleet_agentmanagement.requests.cpu }}
            memory: {{ rancher_fleet_resources.fleet_agentmanagement.requests.memory }}
          limits:
            cpu: {{ rancher_fleet_resources.fleet_agentmanagement.limits.cpu }}
            memory: {{ rancher_fleet_resources.fleet_agentmanagement.limits.memory }}
        gitjob:
          requests:
            cpu: {{ rancher_fleet_resources.gitjob.requests.cpu }}
            memory: {{ rancher_fleet_resources.gitjob.requests.memory }}
          limits:
            cpu: {{ rancher_fleet_resources.gitjob.limits.cpu }}
            memory: {{ rancher_fleet_resources.gitjob.limits.memory }}
        helmops:
          requests:
            cpu: {{ rancher_fleet_resources.helmops.requests.cpu }}
            memory: {{ rancher_fleet_resources.helmops.requests.memory }}
          limits:
            cpu: {{ rancher_fleet_resources.helmops.limits.cpu }}
            memory: {{ rancher_fleet_resources.helmops.limits.memory }}
    webhook: |-
      nodeSelector:
        kubernetes.io/arch: arm64
        node-role.kubernetes.io/control-plane: "true"
      tolerations:
        - key: CriticalAddonsOnly
          operator: Equal
          value: "true"
          effect: NoExecute
