apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
  annotations:
    home-lab.asaharan.dev/load-balancer-provider: metallb
spec:
  valuesContent: |-
    deployment:
      replicas: {{ traefik.replicas }}
    resources:
      requests:
        cpu: {{ traefik.resources.requests.cpu }}
        memory: {{ traefik.resources.requests.memory }}
      limits:
        cpu: {{ traefik.resources.limits.cpu }}
        memory: {{ traefik.resources.limits.memory }}
    podDisruptionBudget:
      enabled: true
      minAvailable: 1
    ingressClass:
      enabled: true
      isDefaultClass: false
      name: {{ traefik.ingress_class_name }}
    providers:
      kubernetesCRD:
        ingressClass: {{ traefik.ingress_class_name }}
      kubernetesIngress:
        ingressClass: {{ traefik.ingress_class_name }}
    api:
      dashboard: false
    ports:
      traefik:
        expose:
          default: false
    service:
      annotations:
        metallb.io/address-pool: {{ traefik.service.address_pool_name }}
        metallb.io/loadBalancerIPs: {{ traefik.service.load_balancer_ip | to_json }}
      spec:
        type: LoadBalancer
{% if traefik.service.load_balancer_class | trim != '' %}
        loadBalancerClass: {{ traefik.service.load_balancer_class }}
{% endif %}
        externalTrafficPolicy: {{ traefik.service.external_traffic_policy }}
    priorityClassName: {{ traefik.priority_class_name }}
    affinity:
      podAntiAffinity:
        requiredDuringSchedulingIgnoredDuringExecution:
          - labelSelector:
              matchLabels:
                app.kubernetes.io/name: traefik
            topologyKey: kubernetes.io/hostname
    topologySpreadConstraints:
      - maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: DoNotSchedule
        labelSelector:
          matchLabels:
            app.kubernetes.io/name: traefik
